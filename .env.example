# MongoDB Connection Configuration
# Option 1: Local MongoDB (default port 27017)
# MONGODB_URI=mongodb://127.0.0.1:27017/sanmarga_balaga

# Option 2: MongoDB Atlas (Free Cloud Database)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/sanmarga_balaga?retryWrites=true&w=majority

MONGODB_URI=mongodb://127.0.0.1:27017/sanmarga_balaga
DB_NAME=sanmarga_balaga
PORT=5500

